rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the authenticated user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Deny access to the root users collection itself by default
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Match journals subcollection
      match /journals/{journalId} {
        allow read, write: if isOwner(userId);

        // Match messages subcollection within a journal
        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }

      // Match summaries subcollection
      match /summaries/{summaryId} {
        allow read, write: if isOwner(userId);
      }

      // Match settings subcollection
      match /settings/{settingsId} {
        allow read, write: if isOwner(userId);
      }

      // Match backups subcollection
      match /backups/{backupId} {
        allow read, write: if isOwner(userId);
      }

      // Match custom themes subcollection
      match /themes/{themeId} {
        allow read, write: if isOwner(userId);
      }

      // Match custom stickers subcollection
      match /stickers/{stickerId} {
        allow read, write: if isOwner(userId);
      }

      // Match user interactions subcollection
      match /interactions/{interactionId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
